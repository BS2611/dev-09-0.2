<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="550.0"
            prefWidth="950.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cs151.frontend.controller.GoalListController">

    <top>
        <VBox alignment="CENTER" spacing="8.0">
            <padding>
                <Insets top="20.0" right="20.0" bottom="10.0" left="20.0"/>
            </padding>

            <Label text="Stored Goals"
                   style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <Label text="Goals are displayed with the most recently created first."/>
        </VBox>
    </top>

    <center>
        <TableView fx:id="goalsTable">
            <columns>
                <TableColumn fx:id="nameColumn"
                             text="Goal Name"
                             prefWidth="135.0"/>

                <TableColumn fx:id="descriptionColumn"
                             text="Description"
                             prefWidth="190.0"/>

                <TableColumn fx:id="categoryColumn"
                             text="Category"
                             prefWidth="100.0"/>

                <TableColumn fx:id="targetDateColumn"
                             text="Target Date"
                             prefWidth="110.0"/>

                <TableColumn fx:id="statusColumn"
                             text="Status"
                             prefWidth="110.0"/>

                <TableColumn fx:id="progressColumn"
                             text="Progress"
                             prefWidth="85.0"/>

                <TableColumn fx:id="creationDateColumn"
                             text="Creation Date"
                             prefWidth="115.0"/>
            </columns>

            <BorderPane.margin>
                <Insets top="10.0" right="20.0" bottom="10.0" left="20.0"/>
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER" spacing="15.0">
            <padding>
                <Insets top="10.0" right="20.0" bottom="20.0" left="20.0"/>
            </padding>

            <Button text="Back" onAction="#goBack"/>
            <Button text="Refresh" onAction="#refreshGoals"/>
        </HBox>
    </bottom>

</BorderPane>